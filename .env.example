# GEMINI_API_KEY: Required for Gemini AI and native Honk AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# CEREBRAS_API_KEY / HONK_KEY: Optional companion for Cerebras AI API calls.
# Users configure this via the Secrets panel in the AI Studio UI.
CEREBRAS_API_KEY=""
HONK_KEY=""

# PIPER_TTS_API_URL: Endpoint URL for Piper TTS HTTP Service (e.g. http://localhost:5000 or https://piper-server.example.com)
PIPER_TTS_API_URL=""

# PIPER_TTS_VOICE: Default Piper voice model (e.g. hi_IN-pratham-medium, en_US-lessac-medium)
PIPER_TTS_VOICE=""

# PIPER_TTS_API_KEY: Optional Bearer token or authorization key for Piper TTS endpoint
PIPER_TTS_API_KEY=""

# PIPER_TTS_VOICE_MAP: Optional JSON mapping language codes to specific Piper voices
PIPER_TTS_VOICE_MAP=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# HONK_API_URL & API_URL: Primary API endpoint for Honk services
HONK_API_URL="https://honkai-seven.vercel.app"
API_URL="https://honkai-seven.vercel.app"
VITE_HONK_API_URL="https://honkai-seven.vercel.app"
VITE_API_URL="https://honkai-seven.vercel.app"
